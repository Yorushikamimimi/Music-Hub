[Unit]
Description=Gunicorn instance to serve Music Hub
After=network-online.target yorushika-radio.service
Wants=yorushika-radio.service
Wants=network-online.target

[Service]
Type=simple
User=musichub
Group=www-data
SupplementaryGroups=musichub
WorkingDirectory=/var/www/My_Homepage
EnvironmentFile=/var/www/My_Homepage/.env
Environment="PATH=/var/www/My_Homepage/venv/bin"
Environment="RADIO_STATION_NAME=Yorushika Radio"
Environment="RADIO_STREAM_URL=/hls/yorushika.m3u8"
RuntimeDirectory=musichub
RuntimeDirectoryMode=0770
ExecStart=/var/www/My_Homepage/venv/bin/gunicorn --workers 2 --bind unix:/run/musichub/musichub.sock --umask 007 --access-logfile - --error-logfile - wsgi:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0027

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
